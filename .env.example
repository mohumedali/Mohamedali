# Canonical production URL — used for metadata, hreflang, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://mohamedali-delta.vercel.app

# Optional: POST endpoint for the contact form (your ASP.NET Core API,
# a Supabase Edge Function, Formspree, ...). It receives JSON:
#   { name, email, service, message }
# Unset: the form's main button sends the message via WhatsApp (email is the secondary option).
# Set: the form posts here, and falls back to WhatsApp if the request fails.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Optional: Google Search Console "HTML tag" verification code (just the content="..." value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
